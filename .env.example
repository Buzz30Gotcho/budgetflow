# Copiez ce fichier en .env puis renseignez vos valeurs :
#   cp .env.example .env

# Base de données PostgreSQL
DB_NAME=budgetflow
DB_USER=budgetflow
DB_PASSWORD=change-me

# Clé secrète pour signer les tokens JWT (encodée en base64, 32 octets minimum).
# Générer une clé : openssl rand -base64 32
JWT_SECRET=change-me-base64-secret
